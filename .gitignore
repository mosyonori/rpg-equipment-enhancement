# Unity用 .gitignore（容量削減強化版）

# ===== Unity関連 =====
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]serSettings/

# ===== Visual Studio関連 =====
*.vs/
.vs/
*.csproj.user
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ===== Visual Studio Code関連 =====
.vscode/
*.code-workspace

# ===== IDE固有ファイル =====
# JetBrains Rider
.idea/
*.sln.iml

# ===== Unity特有の一時ファイル =====
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.stackdump

# ===== Unity Cloud Build =====
/[Uu]nityGenerated/

# ===== Unity Package Manager =====
[Pp]ackages/
manifest.json.meta
packages-lock.json.meta

# ===== 自動生成されるメタファイル =====
*.meta

# ===== OS固有ファイル =====
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ===== 一時ファイル・バックアップ =====
*.tmp
*.bak
*.swp
*~
*.orig

# ===== 大きなバイナリファイル =====
*.exe
*.dll
*.so
*.dylib
*.zip
*.rar
*.7z

# ===== デバッグ・プロファイリング =====
*.log
profilerdata/

# ===== 開発用一時ファイル =====
# CSV編集時のバックアップ
*.csv.bak
*.csv~

# テスト用ファイル
test_*
temp_*

# ===== プロジェクト固有 =====
# Copilotが生成するファイル（容量が大きい）
CopilotIndices/
SemanticSymbols.db
CodeChunks.db

# Unity Accelerator
AcceleratorCache/

# Unity Addressables
AddressableAssetsData/*/

# TextMeshPro
[Tt]extMesh[Pp]ro/

# ===== エディター設定 =====
UserSettings/